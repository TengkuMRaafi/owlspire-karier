APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=15
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pencarian video belajar berlisensi Creative Commons (YouTube Data API v3)
YOUTUBE_API_KEY=

# Pembayaran QRIS (fake | midtrans)
PAYMENT_DRIVER=fake
MIDTRANS_SERVER_KEY=
MIDTRANS_METHOD=qris
MIDTRANS_PRODUCTION=false

# Papan Top 5 karier: dikumpulkan tiap Minggu 00:00 (zona waktu di bawah). LinkedIn, Jobicy, RemoteOK, Arbeitnow tanpa key.
TRENDING_TIMEZONE=Asia/Jakarta
TRENDING_LOCATION=Indonesia

# Bot Telegram OwlSpire.ID (username tanpa @, sesuai yang dibuat di @BotFather) dan kanal opsional
TELEGRAM_BOT_NAME=OwlSpire.ID
# Opsional: ganti teks profil bot (bawaan sudah disesuaikan dengan situs). Diterapkan lewat php artisan telegram:setup
# TELEGRAM_BOT_DESCRIPTION=
# TELEGRAM_BOT_ABOUT=
# Topik bawaan kiriman grup (dipisah koma) sebelum admin grup memakai /topik
TELEGRAM_GROUP_POSITIONS="admin, customer service, staff"
TELEGRAM_BOT_USERNAME=
# Token dari @BotFather dan rahasia webhook (huruf/angka acak). Lalu jalankan: php artisan telegram:setup --webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_CHANNEL_URL=

# Papan skor landing: rating tampil hanya jika diisi (skala 1 sampai 5).
PLATFORM_RATING=
PLATFORM_RATING_COUNT=

# Parafrase AI di hasil ujian (https://console.groq.com/keys)
# Boleh banyak kunci (beda akun) dipisah koma tanpa spasi: GROQ_API_KEY=gsk_aaa,gsk_bbb,gsk_ccc,gsk_ddd
# Kunci yang kena limit otomatis diistirahatkan dan diganti kunci lain. Berlaku juga untuk GEMINI/CEREBRAS/OPENROUTER.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Cadangan otomatis bila Groq kena limit/gagal. Isi satu atau lebih; kosong = dilewati.
# Cek semuanya dengan: php artisan llm:test
# Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
# Cerebras (https://cloud.cerebras.ai)
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
# OpenRouter, model gratis berakhiran :free (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b:free
# Urutan percobaan, dipisah koma
LLM_ORDER=groq,gemini,cerebras,openrouter
# Opsional: urutan penyedia khusus untuk wawancara AI, mis. gemini,groq,cerebras. Kosong = pakai LLM_ORDER.
LLM_INTERVIEW_ORDER=

# Asisten AI di dashboard: jatah pesan per hari (default 5 untuk Gratis, 50 untuk Premium)
CHATBOT_FREE_DAILY=10
CHATBOT_PREMIUM_DAILY=50

# Kuota alat AI per hari (Gratis / Premium). Satu wawancara = satu sesi 5 pertanyaan.
INTERVIEW_FREE_DAILY=1
INTERVIEW_PREMIUM_DAILY=5
CV_ANALYSIS_FREE_DAILY=0
CV_ANALYSIS_PREMIUM_DAILY=5
STUDY_TIMEZONE=Asia/Jakarta

# Fitur khusus Premium (true = terkunci untuk paket Gratis). Admin dan staf selalu lolos.
PREMIUM_ONLY_PLAN=true
PREMIUM_ONLY_INTERVIEW=true

# ---- Keamanan (lihat PANDUAN-UPDATE.md) ----
# Email WAJIB nyata di produksi agar Lupa sandi dan Verifikasi email terkirim (ganti MAIL_MAILER=log di atas).
# Contoh SMTP: MAIL_MAILER=smtp, MAIL_HOST=smtp.brevo.com, MAIL_PORT=587, MAIL_USERNAME=..., MAIL_PASSWORD=...
SESSION_SECURE_COOKIE=false        # isi true bila situs memakai HTTPS
SECURITY_CSP=                      # kosong = aktif otomatis di produksi; true/false untuk memaksa
SECURITY_REQUIRE_ADMIN_2FA=false   # true = admin wajib mengaktifkan verifikasi 2 langkah
SECURITY_LOGIN_MAX_ATTEMPTS=5      # salah sandi per email+IP sebelum dikunci
SECURITY_LOGIN_MAX_ATTEMPTS_EMAIL=12
SECURITY_LOGIN_LOCK_MINUTES=15
# CAPTCHA Cloudflare Turnstile (opsional; kosongkan untuk mematikan)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Masuk dengan Google (opsional; kosongkan untuk menyembunyikan tombolnya)
# Redirect URI di Google Cloud Console: {APP_URL}/masuk/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# true = pengguna biasa hanya bisa daftar/masuk lewat Google (admin dan staf tetap email+sandi). Hanya aktif bila kunci Google terisi.
MEMBERS_GOOGLE_ONLY=false

# Batas perangkat yang boleh masuk bersamaan per akun (admin dan staf tidak dibatasi)
MAX_DEVICES=2
NOTIFY_NEW_DEVICE=true

# Broadcast email dari admin (Admin > Broadcast). Dikirim lewat antrean: jalankan `php artisan queue:work`.
# Pakai SMTP sungguhan (mis. Brevo, gratis sekitar 300 email per hari), bukan MAIL_MAILER=log. APP_URL harus domain asli agar logo di email tampil.
BROADCAST_DELAY_SECONDS=1
BROADCAST_DAILY_LIMIT=300